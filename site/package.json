{
  "name": "zoop-site",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "docusaurus start --host 127.0.0.1 --port 3000 --no-open",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3000 --no-open",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "format:check": "prettier --check src tests tools *.ts *.json README.md AGENTS.md",
    "check:content": "node tools/check-content.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource/geist": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "prism-react-renderer": "2.4.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0",
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "prettier": "3.10.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "tinypool": "2.1.2",
    "serialize-javascript": "7.1.3",
    "sockjs": {
      "uuid": "11.1.1"
    }
  }
}
